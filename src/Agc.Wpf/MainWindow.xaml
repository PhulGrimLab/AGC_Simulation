<Window x:Class="Agc.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Agc.Wpf.Controls"
        Title="Apollo Guidance Computer Simulation — Apollo 11"
        Width="1500" Height="860" MinWidth="1100" MinHeight="700"
        Background="#14161A" Foreground="#E6E8EB"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 절반: DSKY -->
        <Viewbox Grid.Column="0" Stretch="Uniform" Margin="16">
            <c:DskyPanel x:Name="Dsky"/>
        </Viewbox>

        <!-- 오른쪽 절반: 미션 뷰 -->
        <Grid Grid.Column="1" Margin="0,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="PhaseNameText" FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="PhaseDescriptionText" FontSize="14" Foreground="#B5BAC1"
                           TextWrapping="Wrap" Margin="0,4,0,10" MinHeight="40"/>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="8" BorderBrush="#3A3F47" BorderThickness="1" ClipToBounds="True">
                <c:MissionIllustration x:Name="Illustration"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="MetText" Grid.Row="0" Grid.Column="0" FontSize="22" FontFamily="Consolas" FontWeight="Bold"/>
                <TextBlock x:Name="BodyText" Grid.Row="0" Grid.Column="1" FontSize="16"/>
                <TextBlock x:Name="AltitudeText" Grid.Row="1" Grid.Column="0" FontSize="16" FontFamily="Consolas"/>
                <TextBlock x:Name="SpeedText" Grid.Row="1" Grid.Column="1" FontSize="16" FontFamily="Consolas"/>
                <TextBlock x:Name="VerticalSpeedText" Grid.Row="2" Grid.Column="0" FontSize="16" FontFamily="Consolas"/>
                <TextBlock x:Name="PositionText" Grid.Row="2" Grid.Column="1" FontSize="16" FontFamily="Consolas"/>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Slider x:Name="TimelineSlider" Minimum="0" IsMoveToPointEnabled="True"
                        ValueChanged="TimelineSlider_ValueChanged"/>
                <!-- 마지막 열(단계 이동)이 남는 폭을 채워, 좁은 창에서도 잘리지 않는다 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Grid.Column="0" Content="▶ 재생" Width="90" Height="30" Click="PlayButton_Click" Focusable="False"/>
                    <TextBlock Grid.Column="1" Text="배속" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="SpeedBox" Grid.Column="2" Width="90" SelectionChanged="SpeedBox_SelectionChanged" Focusable="False">
                        <ComboBoxItem Content="1×" Tag="1"/>
                        <ComboBoxItem Content="10×" Tag="10"/>
                        <ComboBoxItem Content="60×" Tag="60" IsSelected="True"/>
                        <ComboBoxItem Content="600×" Tag="600"/>
                        <ComboBoxItem Content="3600×" Tag="3600"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="단계 이동" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="PhaseBox" Grid.Column="4" MaxWidth="320" HorizontalAlignment="Stretch"
                              SelectionChanged="PhaseBox_SelectionChanged" Focusable="False"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
