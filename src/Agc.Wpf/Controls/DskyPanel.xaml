<UserControl x:Class="Agc.Wpf.Controls.DskyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agc.Wpf.Controls"
             Width="590" Height="640">
    <UserControl.Resources>
        <!-- 표시창 라벨 (PROG / VERB / NOUN): 실제 DSKY의 흰색 인쇄 글자 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8DADD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 키: 검은 사각 키에 흰 글자 -->
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17181B"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3E4147"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#26282D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#0B0C0E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#44474C" CornerRadius="8" Padding="20" BorderBrush="#2A2C30" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 상태 램프 패널: 2열 x 7행 -->
                <Border Grid.Column="0" Background="#15171A" CornerRadius="3" Padding="6"
                        BorderBrush="#2A2C30" BorderThickness="2">
                    <UniformGrid x:Name="LampGrid" Columns="2" Rows="7"/>
                </Border>

                <!-- 숫자 표시 패널: COMP ACTY / PROG, VERB / NOUN, R1, R2, R3 (5줄) -->
                <Border Grid.Column="2" Background="#050A07" CornerRadius="3" Padding="12,10"
                        BorderBrush="#2A2C30" BorderThickness="2">
                    <StackPanel>
                        <Grid>
                            <Border x:Name="CompActyHost" HorizontalAlignment="Left" VerticalAlignment="Top" Width="96" Height="40"/>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="PROG" Style="{StaticResource FieldLabel}"/>
                                <c:SegmentDisplay x:Name="ProgDisplay" DigitCount="2" Height="40" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <StackPanel HorizontalAlignment="Left" Margin="6,0,0,0">
                                <TextBlock Text="VERB" Style="{StaticResource FieldLabel}"/>
                                <c:SegmentDisplay x:Name="VerbDisplay" DigitCount="2" Height="40" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="NOUN" Style="{StaticResource FieldLabel}"/>
                                <c:SegmentDisplay x:Name="NounDisplay" DigitCount="2" Height="40" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="2" Fill="#2EA36A" Margin="0,8,0,8"/>
                        <c:SegmentDisplay x:Name="R1Display" DigitCount="6" Height="46" HorizontalAlignment="Right"/>
                        <Rectangle Height="2" Fill="#2EA36A" Margin="0,8,0,8"/>
                        <c:SegmentDisplay x:Name="R2Display" DigitCount="6" Height="46" HorizontalAlignment="Right"/>
                        <Rectangle Height="2" Fill="#2EA36A" Margin="0,8,0,8"/>
                        <c:SegmentDisplay x:Name="R3Display" DigitCount="6" Height="46" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 키패드: 7열 x 3행(각 행 = 2 단위). VERB/NOUN, ENTR/RSET은 반 칸 아래에 놓인다. -->
            <Grid x:Name="KeypadGrid" Grid.Row="1" Margin="0,18,0,0"/>
        </Grid>
    </Border>
</UserControl>
