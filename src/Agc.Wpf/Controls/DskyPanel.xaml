<UserControl x:Class="Agc.Wpf.Controls.DskyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agc.Wpf.Controls"
             Width="590" Height="646">
    <UserControl.Resources>
        <!-- 표시창 라벨(PROG / VERB / NOUN): 실제 DSKY처럼 초록 채운 박스에 어두운 글자 -->
        <Style x:Key="FieldLabelBox" TargetType="Border">
            <Setter Property="Background" Value="#2E9E5B"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#06240F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 키: 검은 사각 키에 흰 글자 -->
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17181B"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4D52"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2B2D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#0B0C0E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 밝은 회색 알루미늄 전면 베젤 -->
    <Border Background="#9AA0A4" CornerRadius="8" Padding="20" BorderBrush="#6C7175" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 상태 램프 패널: 2열 x 7행 -->
                <Border Grid.Column="0" Background="#7A8084" CornerRadius="3" Padding="6"
                        BorderBrush="#5C6165" BorderThickness="2">
                    <UniformGrid x:Name="LampGrid" Columns="2" Rows="7"/>
                </Border>

                <!-- 숫자 표시 패널: COMP ACTY / PROG, VERB / NOUN, R1, R2, R3 (5줄) -->
                <Border Grid.Column="2" Background="#050A07" CornerRadius="3" Padding="12,10"
                        BorderBrush="#5C6165" BorderThickness="3">
                    <StackPanel>
                        <Grid>
                            <Border x:Name="CompActyHost" HorizontalAlignment="Left" VerticalAlignment="Top" Width="96" Height="46"/>
                            <StackPanel HorizontalAlignment="Right">
                                <Border Style="{StaticResource FieldLabelBox}">
                                    <TextBlock Text="PROG" Style="{StaticResource FieldLabelText}"/>
                                </Border>
                                <c:SegmentDisplay x:Name="ProgDisplay" DigitCount="2" Height="40" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Left">
                                <Border Style="{StaticResource FieldLabelBox}">
                                    <TextBlock Text="VERB" Style="{StaticResource FieldLabelText}"/>
                                </Border>
                                <c:SegmentDisplay x:Name="VerbDisplay" DigitCount="2" Height="40" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <Border Style="{StaticResource FieldLabelBox}">
                                    <TextBlock Text="NOUN" Style="{StaticResource FieldLabelText}"/>
                                </Border>
                                <c:SegmentDisplay x:Name="NounDisplay" DigitCount="2" Height="40" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="2" Fill="#2EA36A" Margin="0,8,0,8"/>
                        <c:SegmentDisplay x:Name="R1Display" DigitCount="6" Height="46" HorizontalAlignment="Right"/>
                        <Rectangle Height="2" Fill="#2EA36A" Margin="0,8,0,8"/>
                        <c:SegmentDisplay x:Name="R2Display" DigitCount="6" Height="46" HorizontalAlignment="Right"/>
                        <Rectangle Height="2" Fill="#2EA36A" Margin="0,8,0,8"/>
                        <c:SegmentDisplay x:Name="R3Display" DigitCount="6" Height="46" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 키패드: 7열 x 3행(각 행 = 2 단위). VERB/NOUN, ENTR/RSET은 반 칸 아래에 놓인다. -->
            <Border Grid.Row="1" Margin="0,14,0,0" Background="#7A8084" CornerRadius="3" Padding="2"
                    BorderBrush="#5C6165" BorderThickness="2">
                <Grid x:Name="KeypadGrid"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
